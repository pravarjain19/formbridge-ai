# Supabase (needed for login, storage and the database-backed routes)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OCR provider: claude | gemini | mock
# If unset: claude when ANTHROPIC_API_KEY is set, else gemini when GEMINI_API_KEY is set, else mock.
OCR_PROVIDER=mock
ANTHROPIC_API_KEY=
FORMBRIDGE_OCR_MODEL=            # optional, defaults to claude-opus-5-5
# Gemini free tier: Google may use inputs to improve models. Use dummy/masked documents only.
GEMINI_API_KEY=
GEMINI_MODEL=                    # optional, defaults to gemini-2.5-flash

# Set to true to allow /api/ocr/preview with a real provider in production
ALLOW_OCR_PREVIEW=

# Server-only: used after verifying Razorpay payments/webhooks to update plans. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# HMAC key for matching PANs without storing them (any long random string)
PAN_HASH_SECRET=

# Razorpay subscriptions (Dashboard → Settings → API keys; Subscriptions → Plans; Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_AGENCY=

# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
